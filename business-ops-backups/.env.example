# ====================================================================
# BACKUP AUTOMATION ENVIRONMENT VARIABLES (.env.example)
# REPOSITORY: business-ops-backups
# DEPLOYMENT: GitHub Actions Secrets / Environment
# ====================================================================

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AES-256-GCM Encryption Key (Must be 32 bytes)
BACKUP_ENCRYPTION_KEY=your_32_byte_secret_encryption_key_here!

# Google Service Account Credentials (For Drive Upload)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_FOLDER_ID=your_private_google_drive_folder_id_here
