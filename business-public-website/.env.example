# ====================================================================
# PUBLIC WEBSITE ENVIRONMENT VARIABLES (.env.example)
# REPOSITORY: business-public-website
# DEPLOYMENT: Vercel Project #1
# ====================================================================

# Public Supabase Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here

# Server-Only Supabase Service Role Key (NEVER EXPOSE IN BROWSER / NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ISR Cache Revalidation Secret Token
REVALIDATION_SECRET=sanchay_revalidate_secret_key_change_me
