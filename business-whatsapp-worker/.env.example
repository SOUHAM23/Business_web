# ====================================================================
# WHATSAPP WORKER SECRETS & VARIABLES (.env.example)
# REPOSITORY: business-whatsapp-worker
# DEPLOYMENT: Cloudflare Workers (Set via `wrangler secret put <KEY>`)
# ====================================================================

# Meta WhatsApp Cloud API Secrets
META_VERIFY_TOKEN=your_meta_webhook_verification_token
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Supabase Connection Secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Service Account Credentials (For 12-Hour Sheet Snapshot Sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
